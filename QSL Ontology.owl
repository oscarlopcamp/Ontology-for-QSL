            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/oscarlopecamp/ontologies/2026/7/untitled-ontology-46#hasDecisionPoint"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/oscarlopecamp/ontologies/2026/7/untitled-ontology-46#DecisionPoint"/>
