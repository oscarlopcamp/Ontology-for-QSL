                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/oscarlopecamp/ontologies/2026/7/untitled-ontology-46#HardwareConstraint"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
